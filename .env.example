# Optional. Without these the rooms live in .data/rooms.json on the local disk,
# which is fine for a single `next dev` process and wrong for a serverless deploy:
# two lambda instances would each hold half the room.
#
# Any Upstash Redis (or Vercel KV) works. Both env names are read.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
